# ═══════════════════════════════════════════════════════════════════════════════
# Retainr — Backend environment (Express + Prisma + Firebase Admin)
#
# Copy to .env and fill in:   copy .env.example .env
# Every variable the backend reads is listed here — nothing else is read.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Server ─────────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# Port the API listens on (frontend expects 4000 via NEXT_PUBLIC_API_BASE_URL)
PORT=4000
# Comma-separated list of allowed browser origins (frontend dev server)
CORS_ORIGIN=http://localhost:3000

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────────
# Prisma Postgres, Neon, Supabase, or local PostgreSQL — any Postgres works.
# Apply the schema after setting:   npx prisma migrate deploy
# Local:    postgresql://postgres:<password>@localhost:5432/ultra_tasker
# Hosted (add ?sslmode=require):
#           postgres://<user>:<pass>@host:5432/<db>?sslmode=require
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/ultra_tasker

# ─── Firebase Admin (server side) ───────────────────────────────────────────────
# THREE supported modes — pick exactly ONE (priority order: A > B > C > verify-only):
#
# Mode A (full, recommended): paste the entire service-account JSON as ONE line.
#   Firebase Console → Project settings → Service accounts → Generate new private key.
#   Keep the \n escapes inside private_key exactly as downloaded.
#   Enables everything, including Firebase custom-claims sync on role changes.
# FIREBASE_SERVICE_ACCOUNT_KEY={"project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
#
# Mode B (full): the same JSON split into three discrete values.
#   FIREBASE_PROJECT_ID + FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY
#   (keep the \n escapes in the private key)
#
# Mode C (full): leave A and B empty and point ADC at the key file instead.
#   Set GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
#   (GOOGLE_APPLICATION_CREDENTIALS is read by the Firebase Admin SDK directly.)
#
# Verify-only (minimum setup): set ONLY FIREBASE_PROJECT_ID and leave everything
#   else empty. Token verification uses Firebase's public certs — no private key
#   needed. Logins and ALL reads/writes work; only Firebase custom-claims sync on
#   admin role changes is skipped (roles are still enforced from the database).
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# ─── Bootstrap & limits ─────────────────────────────────────────────────────────
# Comma-separated emails granted the ADMIN role on first login
# (promotes only — to demote, change the role in the admin UI).
BOOTSTRAP_ADMIN_EMAILS=you@example.com
# Owner of the demo data for `npm run db:seed`. Set to your Firebase UID
# (visible in GET /api/v1/auth/session after login), then run the seed.
SEED_OWNER_UID=
# Max API requests per 15 min per IP
RATE_LIMIT_MAX=300
